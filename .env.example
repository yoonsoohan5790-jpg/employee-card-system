# Flask
SECRET_KEY=change-this-to-a-random-secret

# Supabase(Postgres) 연결 문자열. 비워두면 로컬 SQLite(database.db)를 사용한다.
# Supabase 대시보드 > Project Settings > Database > Connection string (URI) 값을 사용
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres

# 휴직 종료일 도래 시 자동 재활성화 여부 (true/false)
AUTO_REACTIVATE_ON_LEAVE_END=true

# 로컬 실행 시 백그라운드 스케줄러 사용 여부 (Vercel 등 서버리스에서는 무시됨)
ENABLE_BACKGROUND_SCHEDULER=true
